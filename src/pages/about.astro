---
import Layout from "../layouts/Layout.astro";
import "../../css/blocks.css";
import SectionNav from "../components/SectionNav.astro";
const tools = [
  "TypeScript",
  "Python",
  "LangGraph",
  "Astro",
  "Cloudflare Pages",
  "Codex",
  "ChatGPT",
  "Notion",
];
const sections = [
  {
    id: "why-record",
    title: "为什么开始记录",
    description: "学习的起点与记录的理由",
  },
  {
    id: "practice",
    title: "先从实践出发",
    description: "小项目、踩坑与解决过程",
  },
  {
    id: "contact",
    title: "一起交流",
    description: "通过 GitHub、X 或邮箱联系",
  },
];
const metadata = {
  title: "关于我",
  alternates: { canonical: "/about" },
};
---

<Layout
  title={metadata.title}
  description={metadata.description}
  canonical={metadata.alternates?.canonical}
>
  <div class="block-page">
    <header class="block-hero block-surface">
      <h1>你好，我也在学习。</h1>
      <p>一个零基础 Agent 学生，和一段正在发生的旅程。</p>
    </header>
    <SectionNav items={sections} />
    <section id="toolkit" class="about-toolkit" aria-labelledby="toolkit-title">
      <h2 id="toolkit-title">技术与工具</h2>
      <ul class="tool-tags">
        {tools.map((tool) => <li>{tool}</li>)}
      </ul>
    </section>
    <article class="about-blocks">
      <section
        class="about-story block-surface"
        data-tone="paper"
        aria-labelledby="why-record"
      >
        <h2 id="why-record">为什么开始记录</h2>
        <p>
          这里记录我从零学习 Agent
          的过程：动手做项目、遇到问题，再一点点弄明白。
        </p>
        <p>
          除了 Agent
          本身，也会写到构建它所需的前端、后端和部署知识。希望这些具体的过程，能给走在同一条路上的你一点参考。
        </p>
      </section>
      <section
        class="about-practice block-surface"
        data-tone="navy"
        aria-labelledby="practice"
      >
        <h2 id="practice">先从实践出发</h2>
        <p>从小项目开始，在动手实践中理解代码，记录遇到的问题和解决的过程。</p>
        <blockquote>
          <p>已识乾坤大，尤怜草木青。</p>
        </blockquote>
      </section>
    </article>
  </div>
</Layout>
<style>
  .about-toolkit {
    margin: 28px 0 32px;
    scroll-margin-top: 16px;
  }
  .about-toolkit h2 {
    font-size: 21px;
    font-weight: 500;
    margin-bottom: 16px;
  }
  .tool-tags {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tool-tags li {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 7px 13px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: color-mix(in srgb, var(--paper) 72%, transparent);
    color: var(--ink);
    font-size: 13px;
    line-height: 1.6;
    white-space: nowrap;
    transition:
      transform 160ms ease,
      background-color 160ms ease,
      border-color 160ms ease;
  }
  .tool-tags li:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, var(--paper));
    color: var(--accent-dark);
  }
  .tool-tags li:active {
    transform: translateY(0);
  }
  @media (max-width: 600px) {
    .tool-tags li {
      min-height: 44px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tool-tags li,
    .tool-tags li:hover,
    .tool-tags li:active {
      transition: none;
      transform: none;
    }
  }
  .about-blocks {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 20px;
  }
  .about-story,
  .about-practice {
    min-height: 280px;
  }
  .about-blocks p {
    margin-top: 17px;
  }
  .about-blocks blockquote {
    margin: 30px 0 0;
    padding: 0;
    border: 0;
  }
  .about-blocks blockquote p {
    color: var(--block-ink);
    font-size: 17px;
    line-height: 1.9;
  }
  @media (max-width: 800px) {
    .about-blocks {
      grid-template-columns: 1fr;
    }
    .about-story,
    .about-practice {
      min-height: 0;
    }
  }
</style>
