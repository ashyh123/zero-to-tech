---
import Layout from "../layouts/Layout.astro";
import PageHeading from "../components/PageHeading.astro";
import SectionNav from "../components/SectionNav.astro";
import { site } from "../../data/site.js";
const sections = [
  { id: "why-record", title: "为什么开始记录" },
  { id: "practice", title: "先从实践出发" },
  { id: "contact", title: "一起交流" },
];
const metadata = {
  title: "关于我",
  alternates: { canonical: "/about" },
};
---

<Layout
  title={metadata.title}
  description={metadata.description}
  canonical={metadata.alternates?.canonical}
>
  <>
    <PageHeading
      title="你好，我也在学习。"
      subtitle="一个零基础 Agent 学生，和一段正在发生的旅程。"
    />
    <div class="about-layout">
      <article class="prose">
        <h2 id="why-record">为什么开始记录</h2>
        <p>
          这里记录我从零学习 Agent
          的过程：动手做项目、遇到问题，再一点点弄明白。
        </p>
        <p>
          除了 Agent
          本身，也会写到构建它所需的前端、后端和部署知识。希望这些具体的过程，能给走在同一条路上的你一点参考。
        </p>
        <h2 id="practice">先从实践出发</h2>
        <p>
          从小项目开始，在动手实践中理解代码，记录遇到的问题和解决的过程。
        </p>
        <blockquote>
          <p>已识乾坤大，尤怜草木青。</p>
        </blockquote>
        <h2 id="contact">一起交流</h2>
        <p>如果你也在学习，或对项目有建议，欢迎通过 GitHub 或邮箱联系我。</p>
        <div class="contact-links">
          <a href={site.github}>GitHub / ashyh123</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </article>
      <SectionNav items={sections} />
    </div>
  </>
</Layout>
