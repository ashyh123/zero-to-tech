---
import { site } from "../../data/site.js";
---

<nav class="social-links" aria-label="联系方式">
  <a
    href={`mailto:${site.email}`}
    aria-label={`邮箱联系：${site.email}`}
    title={site.email}
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="3" y="5" width="18" height="14" rx="3" />
      <path d="m4 7 8 6 8-6" />
    </svg>
    <span>邮箱</span>
  </a>
  <a
    href={site.github}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="GitHub：ashyh123"
    title="GitHub / ashyh123"
  >
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.5-.28-5.13-1.25-5.13-5.56 0-1.23.44-2.24 1.16-3.03-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.16a10.8 10.8 0 0 1 5.63 0c2.15-1.46 3.1-1.16 3.1-1.16.61 1.55.23 2.7.11 2.98.72.79 1.16 1.8 1.16 3.03 0 4.32-2.64 5.28-5.15 5.56.4.35.76 1.03.76 2.08v3.1c0 .3.2.65.78.54A11.25 11.25 0 0 0 12 .75Z" />
    </svg>
    <span>GitHub</span>
  </a>
  <a
    href={site.x}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="X：asomer666"
    title="X / @asomer666"
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M4 3h4l12 18h-4L4 3ZM20 3 4 21" />
    </svg>
    <span>X</span>
  </a>
</nav>

<style>
  .social-links {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .social-links a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-width: 54px;
    min-height: 68px;
    color: var(--ink);
    font-size: 11px;
    border-radius: 16px;
  }
  .social-links svg {
    width: 44px;
    height: 44px;
    padding: 11px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: color-mix(in srgb, var(--paper) 60%, transparent);
  }
  .social-links a:hover {
    color: var(--accent-dark);
  }
  .social-links a:hover svg {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .social-links a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
</style>
