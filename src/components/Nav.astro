---
const links = [
  { href: "/", label: "首页" },
  { href: "/blog", label: "文章" },
  { href: "/series", label: "系列" },
  { href: "/works", label: "作品" },
  { href: "/about", label: "关于" },
];
const pathname =
  Astro.url.pathname
    .replace(/\.html$/, "")
    .replace(/\/index$/, "")
    .replace(/\/$/, "") || "/";
---

<nav
  aria-label="主导航"
  class="site-nav tw:flex tw:gap-[8px] tw:mobile:flex-wrap tw:mobile:gap-[5px]"
>
  {links.map(({ href, label }) => {
    const active =
      href === "/"
        ? pathname === "/"
        : pathname === href ||
          pathname.startsWith(`${href}/`);
    return (
      <a
        href={href}
        aria-current={active ? "page" : undefined}
        class={`nav-capsule tw:flex tw:items-center tw:gap-[8px] tw:py-[8px] tw:px-[12px] tw:border tw:border-solid tw:rounded-[6px] tw:text-[14px] tw:mobile:py-[10px] tw:mobile:px-[13px] ${active ? "tw:text-accent tw:bg-nav-active tw:border-nav-active-border tw:hover:text-accent tw:hover:bg-nav-active" : "tw:text-nav tw:border-transparent tw:hover:bg-nav-hover tw:hover:text-ink"}`}
      >
        <span>{label}</span>
      </a>
    );
  })}
</nav>
