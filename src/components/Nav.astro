---
const links = [
  { href: "/", label: "首页" },
  { href: "/blog", label: "文章" },
  { href: "/series", label: "系列" },
  { href: "/works", label: "作品" },
  { href: "/about", label: "关于" },
];
const pathname =
  Astro.url.pathname
    .replace(/\.html$/, "")
    .replace(/\/index$/, "")
    .replace(/\/$/, "") || "/";
---

<nav
  aria-label="主导航"
  class="site-nav tw:flex tw:gap-[8px] tw:mobile:flex-wrap tw:mobile:gap-[5px]"
>
  {links.map(({ href, label }) => {
    const active =
      href === "/"
        ? pathname === "/"
        : pathname === href || pathname.startsWith(`${href}/`);
    return (
      <a
        href={href}
        aria-current={active ? "page" : undefined}
        class="nav-capsule tw:inline-flex tw:items-center tw:justify-center tw:min-h-[38px] tw:gap-[8px] tw:py-[8px] tw:px-[16px] tw:text-[14px] tw:font-medium tw:mobile:px-[14px]"
      >
        <span>{label}</span>
      </a>
    );
  })}
</nav>
