---
import MeteorBackground from "./MeteorBackground.astro";
import styles from "./LoadingIndicator.module.css";
import reel from "./TextStream.module.css";
const loadingLines = [
  "一个零基础",
  "Agent 学生的旅程",
  "从问题出发",
  "在实践中靠近答案",
];
---

<div
  class={`initial-loader ${styles.overlay} tw:fixed tw:inset-0 tw:grid tw:place-items-center tw:isolate tw:z-[1000] tw:bg-loader-bg tw:text-loader-ink tw:font-loader`}
>
  <MeteorBackground />
  <div class="loading-indicator tw:relative tw:z-[1] tw:w-[calc(100vw-48px)] tw:max-w-[1100px] tw:py-[26px]">
    <span class="tw:sr-only">一个零基础 Agent 学生的旅程</span>
    <div
      class={`text-stream ${reel.viewport} tw:relative tw:overflow-hidden tw:text-center`}
      style="--reel-font-size:clamp(28px, 7vw, 100px);--reel-letter-spacing:-0.035em"
      aria-hidden="true"
    >
      <div class={reel.track} data-reel-track>
        {[0, 1].map(() => (
          <div class={reel.copy} data-reel-copy>
            {loadingLines.map((line) => (
              <div class="tw:leading-[1.25] tw:font-semibold tw:py-[6px] tw:whitespace-nowrap">
                {line}
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
    <div
      class={`loading-progress ${styles.progress} tw:w-full tw:max-w-[420px] tw:mx-auto`}
    >
      <div class="loading-heading tw:flex tw:items-baseline tw:justify-between tw:gap-[20px] tw:mb-[15px] tw:text-[12px] tw:text-loader-muted">
        <span data-loading-status>正在打开这段旅程</span>
        <span
          class="loading-percentage tw:text-[var(--tone-eee)] tw:font-loader-mono tw:text-[16px] tw:tabular-nums tw:min-w-[50px] tw:text-right"
          aria-hidden="true"
        >
          8
          <span class="tw:text-[11px] tw:text-[var(--tone-858585)] tw:ml-[3px]">
            %
          </span>
        </span>
      </div>
      <div
        class={`loading-track ${styles.track} tw:h-[6px] tw:rounded-[20px] tw:overflow-hidden`}
        role="progressbar"
        aria-label="页面准备进度"
        aria-valuemin={0}
        aria-valuemax={100}
        aria-valuenow="8"
        aria-valuetext="正在打开这段旅程，准备进度 8%"
      >
        <div
          class={`loading-fill ${styles.fill} tw:h-full tw:relative tw:rounded-[20px]`}
          style="width:8%"
        >
          <span
            class={`${styles.glint} tw:absolute tw:inset-y-0 tw:w-[80px]`}
          />
        </div>
      </div>
      <div class="loading-footnote tw:flex tw:justify-center tw:items-center tw:gap-[8px] tw:mt-[25px] tw:text-loader-note tw:text-[11px] tw:tracking-[0.025em]">
        <span
          class={`${styles.dot} tw:w-[4px] tw:h-[4px] tw:rounded-full tw:bg-loader-muted`}
        />
        <span>不要离开，即将到来</span>
      </div>
    </div>
  </div>
</div>
<script>
  import "../scripts/loading";
</script>
