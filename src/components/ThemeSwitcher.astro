---
import Button from "./starwind/Button.astro";
import ThemeIcon from "./ThemeIcon.astro";
const modes = ["dark", "light"];
---

<div class="theme-switcher tw:shrink-0">
  <Button
    data-theme-trigger
    class="nav-capsule tw:inline-flex tw:items-center tw:justify-center tw:w-[44px] tw:h-[44px] tw:p-0 tw:leading-none tw:text-ink"
    aria-label="切换深浅色主题"
  >
    {modes.map((mode) => (
      <span data-theme-icon={mode} hidden={mode !== "dark"}>
        <ThemeIcon mode={mode} />
      </span>
    ))}
  </Button>
</div>
<script>
  import "../scripts/theme";
</script>
