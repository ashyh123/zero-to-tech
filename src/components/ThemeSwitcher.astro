---
import Button from "./starwind/Button.astro";
import ThemeIcon from "./ThemeIcon.astro";
const modes = ["dark", "light"];
---

<div class="theme-switcher tw:relative tw:shrink-0 tw:mobile:absolute tw:mobile:top-[18px] tw:mobile:right-[68px]">
  <Button
    data-theme-trigger
    class="nav-capsule tw:grid tw:place-items-center tw:w-[36px] tw:h-[36px] tw:border tw:border-solid tw:border-line tw:rounded-full tw:focus-visible:rounded-full tw:bg-panel tw:text-ink tw:hover:bg-nav-hover"
    aria-label="切换深浅色主题"
  >
    {modes.map((mode) => (
      <span data-theme-icon={mode} hidden={mode !== "dark"}>
        <ThemeIcon mode={mode} />
      </span>
    ))}
  </Button>
</div>
<script>
  import "../scripts/theme";
</script>
