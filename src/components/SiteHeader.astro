---
import Nav from "./Nav.astro";
import ThemeSwitcher from "./ThemeSwitcher.astro";
import Button from "./starwind/Button.astro";
import { site } from "../../data/site.js";
---

<header
  data-scroll-header
  data-hidden="false"
  data-floating="false"
  class="site-header tw:sticky tw:top-0 tw:z-[100] tw:w-full tw:shrink-0 tw:bg-transparent tw:border-0 tw:transition-[translate] tw:duration-[420ms] tw:ease-[cubic-bezier(0.22,0.61,0.36,1)] tw:motion-reduce:transition-none"
>
  <div class="header-row tw:w-full tw:max-w-[1100px] tw:mx-auto tw:px-[32px] tw:py-[20px] tw:flex tw:items-center tw:justify-between tw:gap-[24px] tw:mobile:px-[22px] tw:mobile:py-[17px] tw:mobile:flex-wrap tw:mobile:gap-[12px]">
    <div class="header-identity tw:flex tw:items-center">
      <a
        href="/"
        class="wordmark nav-capsule tw:inline-flex tw:items-center tw:gap-[10px] tw:py-[8px] tw:px-[14px] tw:mobile:py-[6px] tw:mobile:px-[12px] tw:text-[17px] tw:leading-[1.6] tw:font-semibold tw:tracking-[0.01em] tw:mobile:text-[15px] tw:mobile:leading-[1.5]"
        aria-label={`${site.author}，首页`}
      >
        <img
          src="/images/avatar.png"
          alt=""
          width="28"
          height="28"
          class="tw:block tw:size-[28px] tw:shrink-0 tw:rounded-full tw:object-cover tw:ring tw:ring-line tw:mobile:size-[24px]"
        />
        {site.author}
      </a>
    </div>
    <div
      id="site-navigation-panel"
      class="site-navigation-panel tw:flex tw:ml-auto tw:mobile:ml-0 tw:mobile:order-last tw:mobile:basis-full tw:mobile:hidden tw:mobile:max-h-[calc(100dvh-105px)] tw:mobile:overflow-auto tw:mobile:pt-[12px]"
    >
      <Nav />
    </div>
    <div class="header-controls tw:flex tw:items-center tw:gap-[8px] tw:shrink-0">
      <ThemeSwitcher />
      <Button
        class="mobile-menu-toggle nav-capsule tw:hidden tw:p-0 tw:mobile:grid tw:mobile:place-items-center tw:w-[44px] tw:h-[44px] tw:mobile:text-[var(--tone-c8d4e5)]"
        aria-label="打开导航菜单"
        aria-expanded="false"
        aria-controls="site-navigation-panel"
      >
        <svg
          class="tw:block tw:w-[20px] tw:h-[20px]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path data-menu-icon d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </Button>
    </div>
  </div>
</header>

<script>
  import "../scripts/navigation";
  import "../scripts/mobile-menu";
</script>

<style is:global>
  .site-header {
    --glass-sheen: rgba(255, 255, 255, 0.05);
    --glass-edge: rgba(255, 255, 255, 0.1);
  }
  :root[data-theme="light"] .site-header {
    --glass-sheen: rgba(255, 255, 255, 0.32);
    --glass-edge: rgba(255, 255, 255, 0.4);
  }
  .site-header .nav-capsule {
    border: 1px solid color-mix(in srgb, var(--ink) 9%, transparent);
    border-radius: 999px;
    background:
      linear-gradient(145deg, var(--glass-sheen), transparent 70%),
      color-mix(in srgb, var(--paper) 22%, transparent);
    color: var(--ink);
    box-shadow:
      inset 0 1px 0 var(--glass-edge),
      0 3px 12px rgba(12, 30, 55, 0.03);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    backdrop-filter: blur(18px) saturate(150%);
    white-space: nowrap;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease,
      color 180ms ease;
  }
  .site-header .nav-capsule[aria-current="page"] {
    background-color: color-mix(in srgb, var(--accent) 12%, transparent);
    border-color: color-mix(in srgb, var(--accent) 25%, transparent);
    color: var(--accent-dark);
  }
  .site-header .nav-capsule:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .site-header .nav-capsule:active {
    box-shadow: inset 0 1px 3px rgba(12, 30, 55, 0.15);
  }
  .site-header[data-floating="true"] .nav-capsule {
    box-shadow:
      inset 0 1px 0 var(--glass-edge),
      0 6px 20px rgba(12, 30, 55, 0.05);
  }
  .site-header .nav-capsule:hover {
    background-color: color-mix(in srgb, var(--accent) 14%, transparent);
    border-color: color-mix(in srgb, var(--accent) 28%, transparent);
    box-shadow:
      inset 0 1px 0 var(--glass-edge),
      0 0 16px color-mix(in srgb, var(--accent) 14%, transparent);
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header .nav-capsule {
      transition: none;
    }
  }
</style>
