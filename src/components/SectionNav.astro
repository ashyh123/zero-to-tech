---
const { items } = Astro.props;
---

<aside class="about-contents block-surface">
  <nav aria-label="关于页章节目录" data-section-navigation>
    <p class="section-nav-label">本页导航</p>
    <ol class="section-track">
      {items.map((item, index) => (
        <li>
          <a
            class="section-link"
            href={`#${item.id}`}
            aria-current={index === 0 ? "location" : undefined}
          >
            <span class="section-title">{item.title}</span>
            <span class="section-description">{item.description}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
</aside>
<style>
  .about-contents {
    margin-bottom: 20px;
  }
  .section-nav-label {
    color: var(--block-muted);
    font-size: 13px;
    margin-bottom: 17px;
  }
  .section-track {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .section-link {
    display: block;
    min-height: 60px;
    padding: 0 0 0 22px;
    position: relative;
    color: var(--block-muted);
  }
  .section-link::before {
    content: "";
    position: absolute;
    left: 0;
    top: 9px;
    width: 9px;
    height: 9px;
    border: 1px solid var(--block-muted);
    border-radius: 50%;
  }
  .section-title {
    display: block;
    font-size: 17px;
    line-height: 1.6;
  }
  .section-description {
    display: block;
    font-size: 13px;
    line-height: 1.85;
    margin-top: 7px;
  }
  .section-link[aria-current="location"] {
    color: var(--block-ink);
  }
  .section-link[aria-current="location"]::before {
    background: var(--block-ink);
    border-color: var(--block-ink);
  }
  @media (max-width: 700px) {
    .section-track {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .section-link {
      min-height: 44px;
      display: flex;
      align-items: center;
    }
    .section-link::before {
      top: 17px;
    }
    .section-description {
      display: none;
    }
  }
</style>
<script>
  import { onPageChange } from "../scripts/page-lifecycle";
  onPageChange((signal) => {
    const nav = document.querySelector("[data-section-navigation]");
    if (!nav) return;
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const headings = links.map((link) =>
      document.getElementById(link.hash.slice(1)),
    );
    let frame = 0;
    let anchored = links.findIndex((link) => link.hash === location.hash);
    function select(index: number) {
      links.forEach((link, i) => {
        if (i === index) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
    }
    function update() {
      frame = 0;
      // A short page can clamp several anchor targets to the same scroll offset.
      // Keep the requested section selected until the reader scrolls manually.
      if (anchored >= 0) {
        select(anchored);
        return;
      }
      const top =
        (document.querySelector<HTMLElement>(".site-header")?.offsetHeight ||
          80) + 28;
      let current = 0;
      headings.forEach((heading, i) => {
        if (heading && heading.getBoundingClientRect().top <= top) current = i;
      });
      if (
        scrollY > 0 &&
        scrollY + innerHeight >= document.documentElement.scrollHeight - 2
      )
        current = links.length - 1;
      select(current);
    }
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    window.addEventListener("scroll", schedule, { passive: true, signal });
    const releaseAnchor = () => {
      anchored = -1;
    };
    ["wheel", "touchstart", "pointerdown", "keydown"].forEach((event) =>
      window.addEventListener(event, releaseAnchor, { passive: true, signal }),
    );
    window.addEventListener(
      "hashchange",
      () => {
        anchored = links.findIndex((link) => link.hash === location.hash);
        schedule();
      },
      { signal },
    );
    window.addEventListener(
      "resize",
      () => {
        releaseAnchor();
        schedule();
      },
      { signal },
    );
    signal.addEventListener("abort", () => cancelAnimationFrame(frame), {
      once: true,
    });
    links.forEach((link, i) =>
      link.addEventListener(
        "click",
        () => {
          anchored = i;
          select(i);
        },
        { signal },
      ),
    );
    update();
  });
</script>
