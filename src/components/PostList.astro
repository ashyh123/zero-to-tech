---
import { formatDate } from "../../lib/date.mjs";
const { posts } = Astro.props;
---

<div class="post-list">
  {posts.map((post, index) => (
    <article
      data-post-tags={JSON.stringify(post.tags)}
      class="post-preview block-surface"
      data-tone={index === 0 ? undefined : "paper"}
    >
      <div class="post-meta-line">
        <time datetime={post.date}>{formatDate(post.date)}</time>
        <span>{post.readingMinutes} 分钟阅读</span>
      </div>
      <h2>
        <a href={`/blog/${post.slug}`}>{post.title}</a>
      </h2>
      <p class="post-description">{post.summary}</p>
      <div class="block-tags" aria-label="文章标签">
        {post.tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
    </article>
  ))}
</div>
<style>
  .post-list {
    display: grid;
    gap: 20px;
  }
  .post-meta-line {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    color: var(--block-muted);
    font-size: 12px;
    margin-bottom: 16px;
  }
  .post-description {
    margin-top: 13px;
  }
  .block-tags {
    margin-top: 20px;
  }
</style>
