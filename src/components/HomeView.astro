---
import PostList from "./PostList.astro";
import { getPosts, getSeries } from "../../lib/content.mjs";

const posts = getPosts();
const series = getSeries();
---

<>
  <header class="home-intro tw:pb-[26px] tw:border-0 tw:border-b tw:border-solid tw:border-line tw:mb-[26px] tw:mobile:pb-[20px] tw:mobile:mb-[22px]">
    <h1 class="tw:text-[clamp(24px,2.5vw,33px)] tw:font-semibold tw:leading-[1.55] tw:tracking-[0.01em] tw:mobile:text-[23px] tw:mobile:leading-[1.65]">
      一个零基础 Agent 学生的旅程
    </h1>
    <p class="tw:text-[14px] tw:text-muted tw:mt-[12px] tw:leading-[1.9] tw:max-w-[680px] tw:mobile:mt-[10px]">
      记录从零学习 Agent 的实践、踩坑与思考，写给同样在入门和动手做项目的人。
    </p>
  </header>
  {posts.length > 0 && (
    <section class="home-section tw:pb-[32px] tw:mobile:pb-[27px]">
      <div class="section-heading tw:flex tw:justify-between tw:items-center tw:gap-[20px] tw:mb-[20px] tw:mobile:gap-[12px] tw:mobile:mb-[16px]">
        <h2 class="tw:text-[22px] tw:font-semibold tw:mobile:text-[20px]">
          学习记录
        </h2>
        <a
          class="tw:text-[12px] tw:text-accent tw:whitespace-nowrap tw:mobile:text-[11px]"
          href="/blog"
        >
          全部文章 <span aria-hidden="true">↗</span>
        </a>
      </div>
      <PostList posts={posts.slice(0, 5)} />
    </section>
  )}
  {series.length > 0 && (
    <section class="home-section home-series tw:pb-[32px] tw:border-0 tw:border-t tw:border-solid tw:border-line tw:pt-[30px] tw:mobile:pb-[27px] tw:mobile:pt-[25px]">
      <div class="section-heading tw:flex tw:justify-between tw:items-center tw:gap-[20px] tw:mb-[24px] tw:mobile:gap-[12px] tw:mobile:mb-[20px]">
        <div>
          <h2 class="tw:text-[22px] tw:font-semibold tw:mobile:text-[20px]">
            系列专题
          </h2>
          <p class="tw:text-[12px] tw:text-muted tw:mt-[7px] tw:mobile:text-[11px]">
            沿着一条线，把零散的实践串起来。
          </p>
        </div>
        <a
          class="tw:text-[12px] tw:text-accent tw:whitespace-nowrap tw:mobile:text-[11px]"
          href="/series"
        >
          全部系列 <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="tw:grid tw:grid-cols-2 tw:gap-[20px] tw:single:grid-cols-1">
        {series.map((item) => (
          <a
            class="tw:p-[25px] tw:border tw:border-solid tw:border-line tw:rounded-[8px] tw:bg-panel"
            href={`/series/${item.slug}`}
          >
            <h3 class="tw:text-[20px]">{item.title}</h3>
            <p class="tw:text-[14px] tw:text-muted tw:my-[12px]">
              {item.description}
            </p>
            <span class="tw:text-[12px] tw:text-accent">
              {item.posts.length} 篇记录
            </span>
          </a>
        ))}
      </div>
    </section>
  )}
</>
